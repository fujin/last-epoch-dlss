diff --git b/Build-Local.ps1 b/Build-Local.ps1
new file mode 100644
index 0000000..b40f25b
--- /dev/null
+++ b/Build-Local.ps1
@@ -0,0 +1,31 @@
+[CmdletBinding()]
+param(
+    [ValidateRange(1,16)][int]$ParallelProcesses = 4,
+    [ValidatePattern('^[a-zA-Z0-9][a-zA-Z0-9_-]*$')][string]$BuildDirectoryName = 'local-build'
+)
+$ErrorActionPreference = 'Stop'
+$forkRoot = [IO.Path]::GetFullPath($PSScriptRoot).TrimEnd('\') + '\'
+$vswhere = 'C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe'
+$msbuild = & $vswhere -latest -products '*' -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find MSBuild\**\Bin\MSBuild.exe | Select-Object -First 1
+if (-not $msbuild) { throw 'Visual Studio C++ Build Tools were not found.' }
+$buildDirectory = Join-Path $forkRoot $BuildDirectoryName
+[IO.Directory]::CreateDirectory($buildDirectory) | Out-Null
+[IO.File]::WriteAllText((Join-Path $forkRoot 'OptiScaler\resource_build_date.h'),
+    ('#define VER_BUILD_DATE "' + [DateTime]::UtcNow.ToString('yyyyMMdd_HHmmss') + '"' + [Environment]::NewLine),
+    [Text.Encoding]::ASCII)
+[IO.File]::WriteAllText((Join-Path $forkRoot 'OptiScaler\resource_build_commit.h'),
+    ('#define VER_BUILD_COMMIT "6bfc4389-local-late-hudless"' + [Environment]::NewLine), [Text.Encoding]::ASCII)
+# Upstream release events package/move files with batch wildcards. This local
+# variant only compiles and links; packaging and deployment are separate.
+$buildArguments = @(
+    (Join-Path $forkRoot 'OptiScaler\OptiScaler.vcxproj'),
+    '/t:Build', '/p:Configuration=Release', '/p:Platform=x64', '/p:PlatformToolset=v143',
+    '/p:PreferredToolArchitecture=x64', "/p:LEBuildProcesses=$ParallelProcesses",
+    "/p:SolutionDir=$forkRoot", "/p:OutDir=$buildDirectory\", "/p:IntDir=$buildDirectory\obj\",
+    '/p:PreBuildEventUseInBuild=false', '/p:PostBuildEventUseInBuild=false',
+    "/m:$ParallelProcesses", '/v:minimal', '/nologo',
+    "/flp:logfile=$buildDirectory\build.log;verbosity=normal"
+)
+& $msbuild @buildArguments
+if ($LASTEXITCODE -ne 0) { throw "OptiScaler local build failed ($LASTEXITCODE). See $buildDirectory\build.log." }
+Write-Host "Local backend built in $buildDirectory. No staged or game backend was replaced."
