+UINT64 Hudfix_Dx11::GetExternalFrameToken()
+{
+    auto& state = State::Instance();
+    auto& config = *Config::Instance();
+    auto* fg = state.currentFG;
+    if (state.isShuttingDown || state.fgChanged || fg == nullptr ||
+        state.activeFgInput != FGInput::Upscaler ||
+        state.swapchainInteropApi != SwapchainInteropApi::Dx11wDx12 ||
+        !config.FGEnabled.value_or_default() || config.FGHUDFix.value_or_default() ||
+        config.FGDisableHudless.value_or_default() || !config.FGUseMutexForSwapchain.value_or_default())
+        return 0;
+
+    // Use the same presentation mutex as FGPresent/ReleaseSwapchain. Never call
+    // this export recursively from inside one of those operations.
+    OwnedLockGuard frameLock(fg->Mutex, 5);
+    std::lock_guard<std::mutex> captureLock(_checkMutex);
+    if (!fg->IsActive() || fg->IsPaused() || fg->IsDispatched() || fg->FrameCount() == 0 ||
+        !fg->HasResource(FG_ResourceType::Depth) || !fg->HasResource(FG_ResourceType::Velocity))
+        return 0;
+
+    if (_externalFeature != fg || _externalFrame != fg->FrameCount() || _externalToken == 0)
+    {
+        if (++_externalNextToken == 0)
+            ++_externalNextToken;
+        _externalToken = _externalNextToken;
+        _externalFrame = fg->FrameCount();
+        _externalFeature = fg;
+        _externalSubmitted = false;
+    }
+    return _externalSubmitted ? 0 : _externalToken;
+}
+
+int Hudfix_Dx11::SubmitExternalHudless(ID3D11DeviceContext* context, ID3D11Texture2D* texture, UINT64 token)
+{
+    if (context == nullptr || texture == nullptr || token == 0)
+        return -1;
+    if (context->GetType() != D3D11_DEVICE_CONTEXT_IMMEDIATE)
+        return -9;
+
+    auto& state = State::Instance();
+    auto& config = *Config::Instance();
+    auto* fg = state.currentFG;
+    if (state.isShuttingDown || state.fgChanged || fg == nullptr ||
+        state.activeFgInput != FGInput::Upscaler ||
+        state.swapchainInteropApi != SwapchainInteropApi::Dx11wDx12 ||
+        !config.FGEnabled.value_or_default())
+        return 0;
+    if (config.FGHUDFix.value_or_default() || config.FGDisableHudless.value_or_default() ||
+        !config.FGUseMutexForSwapchain.value_or_default())
+        return -7;
+
+    OwnedLockGuard frameLock(fg->Mutex, 5);
+    std::lock_guard<std::mutex> captureLock(_checkMutex);
+    if (token != _externalToken || _externalFeature != fg || _externalFrame != fg->FrameCount() ||
+        !fg->IsActive() || fg->IsPaused() || fg->IsDispatched())
+        return -2;
+    if (_externalSubmitted || fg->IsUsingHudless(fg->GetIndex()))
+        return -3;
+
