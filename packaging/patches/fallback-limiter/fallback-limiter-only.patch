diff --git a/OptiScaler/misc/FrameLimitPolicy.h b/OptiScaler/misc/FrameLimitPolicy.h
new file mode 100644
index 0000000..d02c18d
--- /dev/null
+++ b/OptiScaler/misc/FrameLimitPolicy.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+// Fallback limiter policy: output cap includes real and generated frames.
+// For dynamic MFG this uses the configured maximum, a conservative ceiling,
+// not a measurement of the number of images actually displayed this frame.
+namespace FrameLimitPolicy
+{
+constexpr std::uint64_t OutputMultiplier(bool active, std::uint32_t generatedFrames) noexcept
+{
+    return active ? std::uint64_t(generatedFrames) + 1 : 1;
+}
+inline std::uint64_t MinimumIntervalUs(float outputFpsCap, std::uint64_t outputFramesPerRenderedFrame) noexcept
+{
+    if (!std::isfinite(outputFpsCap) || outputFpsCap <= 0.0f)
+        return 0;
+    const double multiplier = static_cast<double>(std::max<std::uint64_t>(1, outputFramesPerRenderedFrame));
+    const double interval = 1000000.0 * multiplier / static_cast<double>(outputFpsCap);
+    // Clamp the complete interval before conversion; invalid/tiny caps and large
+    // counts must not overflow a floating-to-integer conversion or timer math.
+    return static_cast<std::uint64_t>(std::clamp(interval, 0.0, 100000000.0));
+}
+}
