diff --git a/OptiScaler/framegen/PresentationStats.cpp b/OptiScaler/framegen/PresentationStats.cpp
new file mode 100644
index 0000000..4f46e52
--- /dev/null
+++ b/OptiScaler/framegen/PresentationStats.cpp
@@ -0,0 +1,208 @@
+#include "pch.h"
+#include "PresentationStats.h"
+#include <Config.h>
+#include <State.h>
+#include <framegen/IFGFeature_Dx12.h>
+#include <wrl/client.h>
+#include <atomic>
+#include <mutex>
+
+namespace
+{
+using Microsoft::WRL::ComPtr;
+// NVIDIA's documented QueryInterface alternative to slGetNativeInterface.
+constexpr GUID StreamlineNativeInterface =
+    { 0xadec44e2, 0x61f0, 0x45c3, { 0xad, 0x9f, 0x1b, 0x37, 0x37, 0x92, 0x84, 0xff } };
+std::atomic<std::uint64_t> clientPresents { 0 }, lifecycleGeneration { 1 };
+std::mutex snapshotMutex;
+std::uint64_t epoch = 0, observedGeneration = 0, nativeTotal = 0, displayTotal = 0;
+std::uintptr_t identity = 0;
+HWND outputWindow = nullptr;
+UINT width = 0, height = 0, mode = 0;
+DXGI_FORMAT format = DXGI_FORMAT_UNKNOWN;
+UINT lastNative = 0, lastDisplay = 0;
+bool nativeBaseline = false, displayBaseline = false;
+
+void BeginEpoch()
+{
+    if (++epoch == 0)
+        ++epoch;
+    nativeBaseline = displayBaseline = false;
+}
+
+bool CounterDiscontinuous(UINT current, UINT previous)
+{
+    // Ordinary uint32 rollover is allowed. A backward reset or implausibly
+    // distant discontinuity starts a new epoch rather than inventing frames.
+    return static_cast<UINT>(current - previous) > 0x7fffffffU;
+}
+
+int ReadSnapshot(OptiScalerPresentationStatsV1& result)
+{
+    auto& state = State::Instance();
+    auto& config = *Config::Instance();
+    auto* fg = state.currentFG;
+    if (state.isShuttingDown || fg == nullptr || state.currentFGSwapchain == nullptr ||
+        state.activeFgOutput != FGOutput::DLSSG ||
+        state.swapchainInteropApi != SwapchainInteropApi::Dx11wDx12 ||
+        !config.FGUseMutexForSwapchain.value_or_default())
+        return 0;
+
+    // Same lock order as Present/resize and late-HUDless publication. All COM
+    // references remain local so telemetry cannot pin swapchains across resize.
+    OwnedLockGuard frameLock(fg->Mutex, 6);
+    if (state.isShuttingDown || state.currentFG != fg || state.currentFGSwapchain == nullptr)
+        return 0;
+
+    ComPtr<IUnknown> native(state.currentFGSwapchain);
+    bool unwrapped = false, nativeVerified = false;
+    for (int depth = 0; depth != 4; ++depth)
+    {
+        ComPtr<IUnknown> underlying;
+        const auto unwrapResult = native->QueryInterface(StreamlineNativeInterface,
+                                                        reinterpret_cast<void**>(underlying.GetAddressOf()));
+        if (unwrapResult == E_NOINTERFACE)
+        {
+            nativeVerified = true;
+            break;
+        }
+        if (FAILED(unwrapResult) || !underlying)
+            return 0;
+        ComPtr<IUnknown> previousIdentity, nextIdentity;
+        native.As(&previousIdentity);
+        underlying.As(&nextIdentity);
+        if (previousIdentity.Get() == nextIdentity.Get())
+            return 0;
+        native = std::move(underlying);
+        unwrapped = true;
+    }
+    if (!unwrapped || !nativeVerified)
+        return 0; // Refuse an unverified outer proxy's possibly synthetic counters.
+
+    ComPtr<IDXGISwapChain> visible;
+    ComPtr<ID3D12Device> device;
+    ComPtr<IUnknown> canonical;
+    DXGI_SWAP_CHAIN_DESC desc {};
+    DWORD processId = 0;
+    if (FAILED(native.As(&visible)) || FAILED(visible->GetDesc(&desc)) ||
+        FAILED(visible->GetDevice(IID_PPV_ARGS(device.GetAddressOf()))) ||
+        FAILED(visible.As(&canonical)) || desc.OutputWindow == nullptr ||
+        desc.OutputWindow != state.currentSwapchainDesc.OutputWindow || !IsWindowVisible(desc.OutputWindow))
+        return 0;
+    GetWindowThreadProcessId(desc.OutputWindow, &processId);
+    if (processId != GetCurrentProcessId())
+        return 0;
+
+    // currentRealSwapchain is the hidden D3D11 bridge chain and is intentionally
+    // never queried. This chain must be the visible D3D12 presentation target.
+    result.flags = PresentationVisibleChain | PresentationDlssg | PresentationDx11Interop;
+    const bool active = config.FGEnabled.value_or_default() && fg->IsActive() && !fg->IsPaused() && !state.fgChanged;
+    if (active)
+        result.flags |= PresentationFgActive;
+    result.requestedMultiplier = active ? fg->GetInterpolatedFrameCount() + 1 : 1;
+    const UINT currentMode = (active ? 1U : 0U) | (state.fgChanged ? 2U : 0U) |
+                             (result.requestedMultiplier << 8);
+
+    UINT presentCount = 0;
+    DXGI_FRAME_STATISTICS statistics {};
+    const auto nativeResult = visible->GetLastPresentCount(&presentCount);
+    const auto displayResult = visible->GetFrameStatistics(&statistics);
+    result.nativeQueryHResult = nativeResult;
+    result.displayQueryHResult = displayResult;
+
+    std::lock_guard<std::mutex> lock(snapshotMutex);
+    const auto generation = lifecycleGeneration.load();
+    const auto currentIdentity = reinterpret_cast<std::uintptr_t>(canonical.Get());
+    bool newBaseline = false;
+    if (identity != currentIdentity || outputWindow != desc.OutputWindow || width != desc.BufferDesc.Width ||
+        height != desc.BufferDesc.Height || format != desc.BufferDesc.Format || mode != currentMode ||
+        observedGeneration != generation)
+    {
+        identity = currentIdentity;
+        outputWindow = desc.OutputWindow;
+        width = desc.BufferDesc.Width;
+        height = desc.BufferDesc.Height;
+        format = desc.BufferDesc.Format;
+        mode = currentMode;
+        observedGeneration = generation;
+        BeginEpoch();
+        newBaseline = true;
+    }
+    if ((SUCCEEDED(nativeResult) && nativeBaseline && CounterDiscontinuous(presentCount, lastNative)) ||
+        (SUCCEEDED(displayResult) && displayBaseline && CounterDiscontinuous(statistics.PresentCount, lastDisplay)) ||
+        (displayResult == DXGI_ERROR_FRAME_STATISTICS_DISJOINT && displayBaseline))
+    {
+        BeginEpoch();
+        newBaseline = true;
+    }
+    if (SUCCEEDED(nativeResult))
+    {
+        result.flags |= PresentationNativeCounter;
+        if (nativeBaseline)
+            nativeTotal += static_cast<UINT>(presentCount - lastNative);
+        else
+            newBaseline = true;
+        nativeBaseline = true;
+        lastNative = presentCount;
+        result.nativeRaw = presentCount;
+    }
+    if (SUCCEEDED(displayResult))
+    {
+        result.flags |= PresentationDisplayStatistics;
+        if (displayBaseline)
+            displayTotal += static_cast<UINT>(statistics.PresentCount - lastDisplay);
+        else
+            newBaseline = true;
+        displayBaseline = true;
+        lastDisplay = statistics.PresentCount;
+        result.displayRaw = statistics.PresentCount;
+        result.presentRefresh = statistics.PresentRefreshCount;
+        result.syncRefresh = statistics.SyncRefreshCount;
+        result.lastDisplayQpc = statistics.SyncQPCTime.QuadPart;
+    }
+    if (newBaseline)
+        result.flags |= PresentationNewBaseline;
+    LARGE_INTEGER now {}, frequency {};
+    QueryPerformanceCounter(&now);
+    QueryPerformanceFrequency(&frequency);
+    result.epoch = epoch;
+    result.clientPresents = clientPresents.load();
+    result.nativePresentCalls = nativeTotal;
+    result.displayedFrames = displayTotal;
+    result.sampleQpc = now.QuadPart;
+    result.qpcFrequency = frequency.QuadPart;
+    return 1;
+}
+}
+
+void LocalPresentationStats::RecordClientPresent(IDXGISwapChain* swapchain) noexcept
+{
+    const auto& state = State::Instance();
+    if (state.activeFgOutput == FGOutput::DLSSG && state.swapchainInteropApi == SwapchainInteropApi::Dx11wDx12 &&
+        swapchain == state.currentFGSwapchain)
+        clientPresents.fetch_add(1);
+}
+
+void LocalPresentationStats::Invalidate() noexcept { lifecycleGeneration.fetch_add(1); }
+
+extern "C" int __cdecl OptiScaler_GetPresentationStatsV1(OptiScalerPresentationStatsV1* output, std::uint32_t bytes)
+{
+    if (output == nullptr || bytes < sizeof(OptiScalerPresentationStatsV1))
+        return -1;
+    OptiScalerPresentationStatsV1 snapshot {};
+    snapshot.size = sizeof(snapshot);
+    snapshot.version = 1;
+    snapshot.nativeQueryHResult = snapshot.displayQueryHResult = E_NOTIMPL;
+    try
+    {
+        const int status = ReadSnapshot(snapshot);
+        *output = snapshot;
+        return status;
+    }
+    catch (...)
+    {
+        snapshot.flags = 0;
+        *output = snapshot;
+        return -2;
+    }
+}
diff --git a/OptiScaler/framegen/PresentationStats.h b/OptiScaler/framegen/PresentationStats.h
new file mode 100644
index 0000000..5f805ec
--- /dev/null
+++ b/OptiScaler/framegen/PresentationStats.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <cstdint>
+#include <dxgi.h>
+
+#pragma pack(push, 8)
+struct OptiScalerPresentationStatsV1
+{
+    std::uint32_t size, version;
+    std::uint64_t epoch, clientPresents, nativePresentCalls, displayedFrames;
+    std::uint64_t sampleQpc, qpcFrequency;
+    std::uint32_t flags, nativeRaw, displayRaw, presentRefresh, syncRefresh;
+    std::int32_t nativeQueryHResult, displayQueryHResult;
+    std::uint32_t requestedMultiplier;
+    std::uint64_t lastDisplayQpc;
+};
+#pragma pack(pop)
+static_assert(sizeof(OptiScalerPresentationStatsV1) == 96);
+
+enum OptiScalerPresentationFlags : std::uint32_t
+{
+    PresentationVisibleChain = 1, PresentationNativeCounter = 2, PresentationDisplayStatistics = 4,
+    PresentationFgActive = 8, PresentationDlssg = 16, PresentationDx11Interop = 32,
+    PresentationNewBaseline = 64
+};
+
+// Call on the render/present thread. 1=snapshot, 0=unavailable, -1=bad arguments,
+// -2=exception. Query validity is separately indicated by flags/HRESULTs.
+// Compare deltas only within the same epoch; counters are never reset by reads.
+// displayedFrames accumulates DXGI-reported PresentCount deltas, NOT panel scans.
+using OptiScalerGetPresentationStatsV1 = int(__cdecl*)(OptiScalerPresentationStatsV1*, std::uint32_t);
+
+namespace LocalPresentationStats
+{
+void RecordClientPresent(IDXGISwapChain* swapchain) noexcept;
+void Invalidate() noexcept;
+}
