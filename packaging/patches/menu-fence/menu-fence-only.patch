+// Local variant: serialize CPU lifetime changes and explicitly retire GPU work.
+// Present uses try_lock so a resize never waits for another Present to enter.
+// Fence waits refer only to a Signal already submitted while holding this lock;
+// no future submission/FG callback is required to make that fence complete.
+static std::mutex g_overlayMutex;
+static std::atomic<ID3D12GraphicsCommandList*> g_trackedMenuCommandList { nullptr };
+static Microsoft::WRL::ComPtr<ID3D12Device> g_ownedDevice;
+static Microsoft::WRL::ComPtr<ID3D12CommandQueue> g_ownedQueue;
+static Microsoft::WRL::ComPtr<IUnknown> g_swapchainIdentity;
+static Microsoft::WRL::ComPtr<ID3D12Fence> g_overlayFence;
+static DXGI_SWAP_CHAIN_DESC g_overlayDesc {};
+static HANDLE g_overlayFenceEvent = nullptr;
+static UINT64 g_overlayFenceValue = 0;
+static UINT64 g_lastOverlaySubmission = 0;
+static bool g_unfencedOverlaySubmission = false;
+static bool g_overlayWaitWarning = false;
+
+enum class OverlayGpuStatus { Complete, Pending, DeviceLost };
+
+static OverlayGpuStatus WaitForOverlayGpu(DWORD timeoutMs)
+{
+    if (g_ownedDevice && FAILED(g_ownedDevice->GetDeviceRemovedReason()))
+        return OverlayGpuStatus::DeviceLost;
+    if (!g_overlayFence)
+        return g_unfencedOverlaySubmission ? OverlayGpuStatus::Pending : OverlayGpuStatus::Complete;
+
+    // A failed Signal must never make submitted command memory look reusable.
+    // Retry on the same owned queue; otherwise retain every resource.
+    if (g_unfencedOverlaySubmission)
+    {
+        const UINT64 value = ++g_overlayFenceValue;
+        if (!g_ownedQueue || FAILED(g_ownedQueue->Signal(g_overlayFence.Get(), value)))
+            return g_ownedDevice && FAILED(g_ownedDevice->GetDeviceRemovedReason())
+                       ? OverlayGpuStatus::DeviceLost : OverlayGpuStatus::Pending;
+        g_lastOverlaySubmission = value;
+        g_unfencedOverlaySubmission = false;
+    }
+
+    const ULONGLONG start = GetTickCount64();
+    for (;;)
+    {
+        const UINT64 completed = g_overlayFence->GetCompletedValue();
+        if (completed == UINT64_MAX || (g_ownedDevice && FAILED(g_ownedDevice->GetDeviceRemovedReason())))
+            return OverlayGpuStatus::DeviceLost;
+        if (completed >= g_lastOverlaySubmission)
+        {
+            g_overlayWaitWarning = false;
+            return OverlayGpuStatus::Complete;
+        }
+        const ULONGLONG elapsed = GetTickCount64() - start;
+        if (elapsed >= timeoutMs || !g_overlayFenceEvent)
+            return OverlayGpuStatus::Pending;
+        // Register once per short wait, then recheck the fence: an event may
+        // also be signalled by an earlier timed-out registration.
+        if (FAILED(g_overlayFence->SetEventOnCompletion(g_lastOverlaySubmission, g_overlayFenceEvent)))
+            return OverlayGpuStatus::Pending;
+        const DWORD slice = static_cast<DWORD>((std::min)(ULONGLONG(10), ULONGLONG(timeoutMs) - elapsed));
+        if (WaitForSingleObject(g_overlayFenceEvent, slice) == WAIT_FAILED)
+            return OverlayGpuStatus::Pending;
+    }
+}
