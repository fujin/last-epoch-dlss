+static bool ImGui_ImplDX12_UploadCompleted(ImGui_ImplDX12_PendingUpload* upload, DWORD timeout_ms, bool& device_lost)
+{
+    const ULONGLONG started = GetTickCount64();
+    for (;;)
+    {
+        const UINT64 completed = upload->Fence->GetCompletedValue();
+        if (completed == UINT64_MAX || FAILED(upload->Device->GetDeviceRemovedReason()))
+        {
+            device_lost = true;
+            return true;
+        }
+        if (!upload->Signaled)
+            upload->Signaled = SUCCEEDED(upload->Queue->Signal(upload->Fence, 1));
+        if (upload->Signaled && completed >= 1)
+            return true;
+        const ULONGLONG elapsed = GetTickCount64() - started;
+        if (!upload->Signaled || elapsed >= timeout_ms)
+            return false;
+        if (FAILED(upload->Fence->SetEventOnCompletion(1, upload->Event)))
+            return false;
+        const DWORD remaining = static_cast<DWORD>(timeout_ms - elapsed);
+        if (WaitForSingleObject(upload->Event, remaining < 10 ? remaining : 10) == WAIT_FAILED)
+            return false;
+    }
+}
+
+static void ImGui_ImplDX12_ReleaseUpload(ImGui_ImplDX12_PendingUpload* upload)
+{
+    upload->List->Release();
+    upload->Allocator->Release();
+    upload->Upload->Release();
+    upload->Texture->Release();
+    upload->Fence->Release();
+    CloseHandle(upload->Event);
+    upload->Queue->Release();
+    upload->Device->Release();
+    delete upload;
+}
+
+static bool ImGui_ImplDX12_FinishUploads(ImGui_ImplDX12_Data* bd, DWORD timeout_ms)
+{
+    if (FAILED(bd->pd3dDevice->GetDeviceRemovedReason()))
+        bd->UploadDeviceLost = true;
+    auto** link = &bd->PendingUploads;
+    while (*link)
+    {
+        auto* upload = *link;
+        if (!ImGui_ImplDX12_UploadCompleted(upload, timeout_ms, bd->UploadDeviceLost))
+            return false;
+        *link = upload->Next;
+        ImGui_ImplDX12_ReleaseUpload(upload);
+    }
+    return !bd->UploadDeviceLost;
+}
+
+static void ImGui_ImplDX12_CollectRetiredUploads()
+{
+    const std::lock_guard<std::mutex> lock(g_retiredUploadMutex);
+    auto** link = &g_retiredUploads;
+    while (*link)
+    {
+        auto* upload = *link;
+        bool device_lost = false;
+        if (!ImGui_ImplDX12_UploadCompleted(upload, 0, device_lost))
+        {
+            link = &upload->Next;
+            continue;
+        }
+        *link = upload->Next;
+        ImGui_ImplDX12_ReleaseUpload(upload);
+    }
+}
