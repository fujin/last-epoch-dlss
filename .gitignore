# Publish only the mod's source, scripts, documentation and curated source patches.
/*
!/.gitignore
!/.gitattributes
# Expose only the reviewed offline workflow within GitHub metadata.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/offline-checks.yml
!/README.txt
!/REPOSITORY.txt
!/NOTICE
!/src/
!/scripts/
!/packaging/
!/docs/

# Build outputs, generated interop and temporary diagnostic projects.
**/bin/
**/obj/
**/probe-out/
**/.vs/
**/.idea/
**/CMakeFiles/
**/CMakeCache.txt
*.user
*.suo
*.cache
*.tmp

# Never commit game/runtime binaries, downloaded models, archives or logs.
*.dll
*.exe
*.pdb
*.lib
*.obj
*.o
*.a
*.so
*.dylib
*.zip
*.7z
*.rar
*.tar
*.gz
*.onnx
*.safetensors
*.bin
*.log
*.dmp
*.bmp
*.png
*.jpg
*.assets
*.bundle
*.bank
*.resS
*.save
*.bak

# Local credentials and signing material do not belong in this repository.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json
